# .env.example — All required and optional environment variables for ReClaw Scaffold.
#
# SETUP: Run `cp .env.example .env` then fill in your values.
# NEVER commit .env to git — it contains secrets.

# ── Discord ───────────────────────────────────────────────────────────────────

# Bot token from discord.com/developers → Your App → Bot → Token
DISCORD_BOT_TOKEN=

# Your Discord server (guild) ID
# How to get it: Enable Developer Mode in Discord (Settings → Advanced → Developer Mode)
# then right-click your server → Copy Server ID
DISCORD_GUILD_ID=

# Channel ID where the heartbeat sends proactive alerts (optional)
# Right-click any channel → Copy Channel ID
DISCORD_HEARTBEAT_CHANNEL=

# ── Claude / LLM Routing ──────────────────────────────────────────────────────

# Set to "true" to use Claude Code SDK proxy (works with Claude Max subscription, no API key needed)
# Set to "false" to use a direct API key instead
OPENCLAW_USE_SDK=true

# URL of the local Claude Code proxy (only used when OPENCLAW_USE_SDK=true)
# Default: http://127.0.0.1:3456
# Start it with: claude --serve (requires Claude Code CLI installed)
OPENCLAW_PROXY_URL=http://127.0.0.1:3456

# Claude model to use for agent responses
# Options: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-3-5
OPENCLAW_MODEL=claude-sonnet-4-5

# API key — only needed if OPENCLAW_USE_SDK=false and you are calling Anthropic directly
# OPENCLAW_API_KEY=sk-ant-...

# ── Optional — Enhanced Capabilities ─────────────────────────────────────────

# Perplexity API key — enables web search in heartbeats and the daily brief skill
# Get one at: perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Paths (rarely need to change) ────────────────────────────────────────────

# Root directory for memory files (relative to project root)
MEMORY_DIR=workspace/memory

# Root directory for persona soul files
SOULS_DIR=workspace/souls
